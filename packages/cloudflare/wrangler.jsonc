{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "OPENCODE", "class_name": "OpenCode" }]
  },
  "r2_buckets": [{ "binding": "WORKERD_R2", "bucket_name": "opencode-skills" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OpenCode"] }]
}
